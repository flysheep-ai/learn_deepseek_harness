# 不填也能跑：每一章都支持 `python code.py --demo`（离线假模型，无需 key）
#
# 想连真实模型，复制本文件为 .env 并填写。

# openai | anthropic   （不填则自动推断）
LLM_PROVIDER=openai

# OpenAI 兼容端点（DeepSeek / Kimi / Qwen / vLLM / Ollama / OpenAI 都是这个形状）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# Anthropic 示例
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-xxxx
# LLM_MODEL=claude-sonnet-4-5
